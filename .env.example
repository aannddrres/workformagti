# ──────────────────────────────────────────────────────────────────────────
# Magti Internal Portal — environment configuration
# Copy to ".env" and adjust. Never commit the real .env to version control.
# ──────────────────────────────────────────────────────────────────────────

# Strong random secret for signing JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Consumed both by the app's own dotenv load (config.py) AND, when running via
# docker-compose.yml, by that file's ${SECRET_KEY} substitution — one value,
# two consumers.
SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Environment ──────────────────────────────────────────────────────────
# "production" disables developer-only conveniences (JIT test-account
# provisioning, password-less test-account login, verbose tracebacks). Must
# be "production" for any real deployment — see security.py's is_production
# gate. Also read by docker-compose.yml's ${APP_ENV} substitution.
APP_ENV=development

# ── Database ───────────────────────────────────────────────────────────────
# Local development (default if unset):
# DATABASE_URL=sqlite:///./magti_portal.db
#
# Production (PostgreSQL). Requires psycopg2-binary (see requirements.txt).
# When running via docker-compose.yml, the host must be "db" (the service
# name, not localhost) and the user must match POSTGRES_USER (appuser):
DATABASE_URL=postgresql+psycopg2://magti:CHANGE_ME@localhost:5432/magti_portal

# Postgres container password (docker-compose.yml's ${POSTGRES_PASSWORD} —
# must match the password embedded in DATABASE_URL above when using Compose).
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── CORS (comma-separated origins allowed to call the API) ─────────────────
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# ── Auth cookie hardening (set true behind HTTPS in production) ────────────
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Uploads ────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# ── Data retention ─────────────────────────────────────────────────────────
# Audit-log and article-view-log rows older than this many days are exported
# to archives/*.json and purged from the DB (retention.py, run daily by the
# backup container after each backup).
AUDIT_RETENTION_DAYS=180
