magti_portal.db*
venv/
.venv/
__pycache__/
*.pyc
*.bak
*.png
# ...but the two app logos are real source assets, referenced by
# angular-frontend/src/app/shared/logo/logo.ts. The blanket rule above was
# hiding them from git status entirely, so a fresh clone rendered no logo.
!angular-frontend/public/*.png
uploads/
backups/
archives/
.env
.claude/*
!.claude/launch.json
!.claude/settings.json
# Repo-authored skills live under .claude/skills/ as real files and are
# tracked. The five below are NTFS junctions into .agents/skills/ -- git
# followed them and committed a second, byte-identical copy (226 files,
# 2.8 MB, the same tree object as .agents/skills/). One copy is enough;
# scripts/link-skills recreates the junctions on a fresh clone.
!.claude/skills/
.claude/skills/angular-developer/
.claude/skills/db/
.claude/skills/debugging-wizard/
.claude/skills/java-architect/
.claude/skills/test-master/
scripts/legacy/
_server_log.txt
logs/

# Vendored build tool — download the standalone Tailwind CLI locally rather than
# committing the binary (see README "Rebuilding CSS"). v4 is the old mismatched
# binary; v3 matches the project config.
tailwindcss.exe
tailwindcss-v3.exe

# One-time raw scrape used for the initial news-content seed (182MB) — the
# actual data lives in the DB now, not read from this file at runtime.
src/data/news/news_data.json

# Real JWTs from fetch_tokens.sh -- never commit live tokens even for a
# dev-only test instance.
scripts/load/tokens.json
scripts/load/staging-users.json

# Local-only presentation stack credentials and generated verification reports.
.presentation.env
.presentation-artifacts/
# Generated demo identities (fictional names/positions/phones for the ~600
# seeded accounts). Produced on demand by generate_identities.py and applied
# to the demo DB -- output, not source.
scripts/presentation/generated_identities.csv

# Same, for the UAT stack. .uat-artifacts holds the evidence captured during
# an acceptance run -- screenshots and, crucially, downloaded compliance
# EXPORTS, which contain real names, departments and reading histories for
# every person in the seeded organisation. That must never reach the repo.
.uat.env
.uat-artifacts/

# Generated knowledge-graph output (graphify skill): 18 MB of AST caches and
# a rebuilt graph.json/graph.html. Regenerated from the source tree on demand.
graphify-out/
