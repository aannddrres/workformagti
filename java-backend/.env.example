# ──────────────────────────────────────────────────────────────────────────
# Magti Portal (Java/Spring Boot) — environment configuration
# Copy to ".env" and adjust for real deployment. Never commit the real .env.
# Mirrors the repo-root .env.example (Python app) one-for-one where the same
# concern applies -- see PortalProperties.java / application.yml for how
# each of these binds.
# ──────────────────────────────────────────────────────────────────────────

# Strong random secret for signing JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# With APP_ENV=production ProductionSafetyGuard refuses to boot on the value
# below: it rejects the dev default, anything under 48 characters, anything
# containing a placeholder marker ("change-me", "example", ...) and anything
# with fewer than 10 distinct characters. Replace it, do not shorten it.
SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Environment ──────────────────────────────────────────────────────────
# "production" enables ProductionSafetyGuard's startup checks and disables
# the JIT test-account bypass in AuthenticationService. This is also the
# default baked into application.yml and the Dockerfile, so a deployment that
# forgets this line still fails safe (audit OPUS5 SEC-01). Leave it as-is.
APP_ENV=production

# Password-less login for the known dev/test emails (admin@magti.ge and
# friends, test_operator_*), pending the real AD integration. Two things must
# be true for it to be live: APP_ENV must NOT be production, and this must be
# true. Setting it true with APP_ENV=production is a startup failure, not a
# warning. For local development prefer the dev profile, which sets both:
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
ALLOW_DEV_LOGIN=false

# ── Database (Oracle 19c) ───────────────────────────────────────────────
ORACLE_DB_URL=jdbc:oracle:thin:@localhost:1521/orclpdb1
ORACLE_DB_USER=magti_app
ORACLE_DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── Auth cookie hardening (set true behind HTTPS in production) ────────────
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
