# ──────────────────────────────────────────────────────────────────────────
# Magti Portal (Java/Spring Boot) — environment configuration
# Copy to ".env" and adjust for real deployment. Never commit the real .env.
# Mirrors the repo-root .env.example (Python app) one-for-one where the same
# concern applies -- see PortalProperties.java / application.yml for how
# each of these binds.
# ──────────────────────────────────────────────────────────────────────────

# Strong random secret for signing JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ProductionSafetyGuard refuses to boot if this is still the dev default
# and APP_ENV=production.
SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Environment ──────────────────────────────────────────────────────────
# "production" enables ProductionSafetyGuard's startup checks and disables
# the JIT test-account bypass in AuthenticationService. Must be "production"
# for any real deployment.
APP_ENV=development

# ── Database (Oracle 19c) ───────────────────────────────────────────────
ORACLE_DB_URL=jdbc:oracle:thin:@localhost:1521/orclpdb1
ORACLE_DB_USER=magti_app
ORACLE_DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── Auth cookie hardening (set true behind HTTPS in production) ────────────
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
