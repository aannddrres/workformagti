<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>ge.magti</groupId>
	<artifactId>portal-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>portal-backend</name>
	<description>Magti portal backend - Java/Spring Boot port</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Pinned explicitly rather than relying on JDK 21's JEP 400 UTF-8
			 default or Maven's own default: source files here contain literal
			 Georgian text (department-matching keywords/comments), and this
			 guarantees javac reads them as UTF-8 on any machine/CI runner,
			 not just this one. -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Overrides the 11.0.22 Spring Boot 4.1.0 manages. That version
			 carries three CRITICAL advisories fixed in 11.0.25:
			 CVE-2026-65182 (security constraint bypass), CVE-2026-65905
			 (DIGEST replay) and CVE-2026-68525 (FORM authentication bypass),
			 found by the supply-chain job's own SBOM scan. Drop this line once
			 the Boot parent manages 11.0.25 or later. -->
		<tomcat.version>11.0.26</tomcat.version>
		<!-- Override the Jackson 2.21.4 and 3.1.4 Spring Boot 4.1.0 manages.
			 Both carry CVE-2026-68497 (HIGH: CPU denial of service through
			 unbounded numeric parsing), fixed in 2.21.6 and 3.1.6 and found by
			 the same SBOM scan on 2026-09-29. Drop these once the Boot parent
			 manages those versions or later.
			 Raised to 2.21.7 and 3.1.7 on 2026-10-03: the scan of PR #38 found
			 four more HIGH advisories in both lines, all fixed there —
			 CVE-2026-89407 and CVE-2026-89425 (jackson-core), CVE-2026-91776
			 and CVE-2026-91777 (jackson-databind). -->
		<jackson-2-bom.version>2.21.7</jackson-2-bom.version>
		<jackson-bom.version>3.1.7</jackson-bom.version>
		<!-- Tests run in the zone the backend runs in. The image sets none, so
			 it is UTC, and so is CI. A workstation in Tbilisi otherwise hides
			 every bug that only a JVM not at +04:00 shows: V50's export lease
			 passed there and failed on every UTC run. Read by surefire. -->
		<argLine>-Duser.timezone=UTC</argLine>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Metrics in a form an operator can actually graph. Actuator alone
			 answers only "up" or "down"; with this on the classpath the same
			 endpoint set gains /actuator/prometheus, which is request rate,
			 latency percentiles, error counts by status, JVM heap and the
			 Hikari pool. Version comes from the Spring Boot BOM, matching
			 the micrometer-core the starter already pulls in. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<!-- Re-added 2026-07-30: real Oracle dev instance now exists
			 (localhost:1521/orclpdb1, see docs/JAVA_ORACLE_ANGULAR_MIGRATION.md
			 Phase 1b). Schema is Flyway-owned, not Hibernate-owned, see
			 application.yml's jpa.hibernate.ddl-auto=validate comment. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Explicit, versioned, idempotent migrations, same reason
			 CLAUDE.md requires migrate.py to stay idempotent on the Python
			 side ("workers race on CREATE TABLE otherwise"). Flyway's own
			 locking table closes that race; Hibernate ddl-auto=update would
			 not. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-oracle</artifactId>
		</dependency>
		<!-- Spring Boot 4.1 split FlywayAutoConfiguration out of the old
			 monolithic spring-boot-autoconfigure jar into its own module,
			 same pattern as spring-boot-hibernate/spring-boot-jdbc above.
			 flyway-core alone (the vendor-neutral migration engine) does not
			 pull this in. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- PermissionsConverter needs raw Jackson at compile scope for the
			 JSON-in-a-CLOB column encoding. spring-boot-starter-json exists
			 in Spring Boot 4.1 but only pulls in the new spring-boot-jackson
			 wrapper module, not com.fasterxml.jackson.databind directly
			 (that currently reaches this project only transitively, at
			 runtime scope, via jjwt-jackson), confirmed by inspecting the
			 actual dependency:tree output, not assumed. Declaring it
			 directly here is simpler than adopting Spring's new Jackson
			 abstraction for one converter class. No version pinned: Spring
			 Boot's own BOM manages it (resolves to the same version
			 jjwt-jackson already pulls in; see jackson-2-bom.version above). -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<dependency>
			<groupId>com.oracle.database.jdbc</groupId>
			<artifactId>ojdbc11</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- JWT: mirrors python-jose's role in security.py (simple, direct
			 encode/decode, not a full OAuth2 authorization server). -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

		<!-- HtmlDiffer (article revision diffing): mirrors diffing.py's role.
			 jsoup replaces BeautifulSoup for block-element extraction;
			 java-diff-utils (Myers algorithm) replaces difflib.SequenceMatcher
			 (Ratcliff-Obershelp) for the actual diff, a different algorithm,
			 not a port of Python's, since the migration doc's own acceptance
			 criterion for this endpoint only requires identical ins/del
			 semantics, not identical markup. -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
			<version>1.18.1</version>
		</dependency>
		<dependency>
			<groupId>io.github.java-diff-utils</groupId>
			<artifactId>java-diff-utils</artifactId>
			<version>4.12</version>
		</dependency>

		<!-- Exports domain: openpyxl/reportlab equivalents. Apache POI is the
			 de facto Java standard for XLSX (Apache-2.0, no serious
			 alternative worth weighing). PDFBox chosen over OpenPDF/iText for
			 PDF generation: also Apache-2.0 (OpenPDF is LGPL/MPL, iText 7 is
			 AGPL and a poor fit for a proprietary network-served app);
			 user-confirmed choice, 2026-08-06. PDFBox has no built-in
			 high-level "Table" component like reportlab's Platypus, so
			 PdfExportBuilder lays out rows/pagination by hand. -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.3.0</version>
		</dependency>
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.3</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Testcontainers, test scope only.
			 The Oracle-tagged half of the suite needs a real Oracle. CI's oracle
			 job supplies one through `services:` and sets ORACLE_DB_URL, and a
			 developer with a local instance sets the same variable. Neither helps
			 somebody with only Docker, so ~257 tests were unrunnable for them,
			 which is how a database-bound suite quietly becomes one nobody runs
			 before pushing.

			 OracleTestcontainer starts a container only when nothing is already
			 answering: ORACLE_DB_URL set short-circuits it, and with the variable
			 unset it probes the configured URL before deciding, so a local
			 instance on application.yml's default is used rather than duplicated.
			 This adds a path, it does not take one away. Versions come from the Spring Boot
			 parent (testcontainers 2.0.5), which is also why the artifact ids
			 carry 2.x's `testcontainers-` prefix. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-oracle-xe</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!--
			 A CycloneDX Software Bill of Materials: the exact list of every
			 dependency (and its version) this backend ships, in the machine
			 format procurement and security teams now ask for by name (EU CRA,
			 US EO 14028). Bound to `package`, so `mvn package` drops
			 target/bom.json alongside the jar with no extra command. The CI
			 supply-chain job then scans that file for known advisories: the
			 point-in-time backend check Dependabot's rolling PRs never gave.
			-->
			<plugin>
				<groupId>org.cyclonedx</groupId>
				<artifactId>cyclonedx-maven-plugin</artifactId>
				<version>2.9.1</version>
				<configuration>
					<projectType>application</projectType>
					<outputFormat>json</outputFormat>
					<outputName>bom</outputName>
					<!-- what actually ships: runtime + compile, not test/build tooling -->
					<includeTestScope>false</includeTestScope>
					<schemaVersion>1.5</schemaVersion>
				</configuration>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>makeAggregateBom</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!--
			 Static analysis: SpotBugs plus the FindSecBugs security rules, read
			 from the compiled classes. It catches a different class of mistake
			 from the tests: a null that only some paths produce, a resource
			 left open on an exception edge, a query or path built from input.
			 Not bound to a phase, so the test loop stays as fast as it was;
			 CI's java-unit job and scripts/verify-like-ci.sh call it by name:
			   ./mvnw -B -DskipTests compile spotbugs:check
			 It fails on any finding not in spotbugs-exclude.xml, and every
			 entry there says why it was judged harmless. Added 2026-10-03.
			-->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.10.4.1</version>
				<configuration>
					<effort>Max</effort>
					<threshold>Medium</threshold>
					<excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
					<plugins>
						<plugin>
							<groupId>com.h3xstream.findsecbugs</groupId>
							<artifactId>findsecbugs-plugin</artifactId>
							<version>1.14.0</version>
						</plugin>
					</plugins>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- How strong are the tests on the rules that decide who sees what?
			 PIT changes those classes' bytecode in memory, one small change at
			 a time (a > becomes >=, a condition is dropped), and reports every
			 change no DB-free test noticed. Nothing on disk is edited.
			 Run: ./mvnw -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage
			 Report: target/pit-reports/index.html. Added 2026-10-02. -->
		<profile>
			<id>mutation</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<version>1.30.0</version>
						<dependencies>
							<dependency>
								<groupId>org.pitest</groupId>
								<artifactId>pitest-junit5-plugin</artifactId>
								<version>1.2.3</version>
							</dependency>
						</dependencies>
						<configuration>
							<targetClasses>
								<param>ge.magti.portal.article.ArticleVisibility</param>
								<param>ge.magti.portal.news.NewsVisibility</param>
								<param>ge.magti.portal.video.VideoVisibility</param>
								<param>ge.magti.portal.util.DepartmentMatcher</param>
								<param>ge.magti.portal.security.ManagerScope</param>
								<param>ge.magti.portal.compliance.ComplianceCalculator</param>
								<param>ge.magti.portal.compliance.ReadingProgress</param>
								<param>ge.magti.portal.compliance.MandatoryReach</param>
								<param>ge.magti.portal.stats.OperatorStatsBuilder</param>
								<param>ge.magti.portal.stats.DepartmentStatsBuilder</param>
								<param>ge.magti.portal.quiz.QuizGateChecker</param>
								<param>ge.magti.portal.config.PortalProperties</param>
								<param>ge.magti.portal.security.ClientIpResolver</param>
								<!-- Added 2026-10-03 (QA round 5): who may open a file,
									 what a spreadsheet cell may start with, whether the
									 audit chain is intact, when a session ends, the login
									 throttle, and the shared endpoint guards. -->
								<param>ge.magti.portal.storage.FileAccessPolicy</param>
								<param>ge.magti.portal.export.ExportCellSanitizer</param>
								<param>ge.magti.portal.audit.AuditChainService</param>
								<param>ge.magti.portal.security.PortalSessionService</param>
								<param>ge.magti.portal.security.LoginRateLimiter</param>
								<param>ge.magti.portal.web.Guards</param>
							</targetClasses>
							<targetTests>
								<param>ge.magti.portal.*</param>
							</targetTests>
							<excludedGroups>
								<param>oracle</param>
							</excludedGroups>
							<threads>4</threads>
							<timestampedReports>false</timestampedReports>
							<outputFormats>
								<param>HTML</param>
								<param>XML</param>
							</outputFormats>
							<jvmArgs>
								<value>-Duser.timezone=UTC</value>
							</jvmArgs>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!-- The same, for the two rules only the Oracle-backed tests reach:
			 MandatoryReach (does a reading bind anyone now, PO-40) and the quiz
			 gate. Slow (each change reruns Spring tests) and needs the
			 ORACLE_DB_* variables of the Oracle suite. Added 2026-10-02. -->
		<profile>
			<id>mutation-oracle</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<version>1.30.0</version>
						<dependencies>
							<dependency>
								<groupId>org.pitest</groupId>
								<artifactId>pitest-junit5-plugin</artifactId>
								<version>1.2.3</version>
							</dependency>
						</dependencies>
						<configuration>
							<targetClasses>
								<param>ge.magti.portal.compliance.MandatoryReach</param>
								<param>ge.magti.portal.quiz.QuizGateChecker</param>
							</targetClasses>
							<targetTests>
								<param>ge.magti.portal.web.MandatoryReachIntegrationTest</param>
								<param>ge.magti.portal.web.RoleFlowIntegrationTest</param>
								<param>ge.magti.portal.web.QuizControllerIntegrationTest</param>
								<param>ge.magti.portal.web.ComplianceControllerIntegrationTest</param>
								<param>ge.magti.portal.compliance.*</param>
							</targetTests>
							<threads>1</threads>
							<timeoutConstant>60000</timeoutConstant>
							<timestampedReports>false</timestampedReports>
							<reportsDirectory>${project.build.directory}/pit-reports-oracle</reportsDirectory>
							<outputFormats>
								<param>HTML</param>
								<param>XML</param>
							</outputFormats>
							<jvmArgs>
								<value>-Duser.timezone=UTC</value>
							</jvmArgs>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
