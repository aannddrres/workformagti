<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>ge.magti</groupId>
	<artifactId>portal-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>portal-backend</name>
	<description>Magti portal backend - Java/Spring Boot port</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Pinned explicitly rather than relying on JDK 21's JEP 400 UTF-8
			 default or Maven's own default: source files here contain literal
			 Georgian text (department-matching keywords/comments), and this
			 guarantees javac reads them as UTF-8 on any machine/CI runner,
			 not just this one. -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Re-added 2026-07-30: real Oracle dev instance now exists
			 (localhost:1521/orclpdb1, see docs/JAVA_ORACLE_ANGULAR_MIGRATION.md
			 Phase 1b). Schema is Flyway-owned, not Hibernate-owned, see
			 application.yml's jpa.hibernate.ddl-auto=validate comment. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Explicit, versioned, idempotent migrations, same reason
			 CLAUDE.md requires migrate.py to stay idempotent on the Python
			 side ("workers race on CREATE TABLE otherwise"). Flyway's own
			 locking table closes that race; Hibernate ddl-auto=update would
			 not. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-oracle</artifactId>
		</dependency>
		<!-- Spring Boot 4.1 split FlywayAutoConfiguration out of the old
			 monolithic spring-boot-autoconfigure jar into its own module,
			 same pattern as spring-boot-hibernate/spring-boot-jdbc above.
			 flyway-core alone (the vendor-neutral migration engine) does not
			 pull this in. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- PermissionsConverter needs raw Jackson at compile scope for the
			 JSON-in-a-CLOB column encoding. spring-boot-starter-json exists
			 in Spring Boot 4.1 but only pulls in the new spring-boot-jackson
			 wrapper module, not com.fasterxml.jackson.databind directly
			 (that currently reaches this project only transitively, at
			 runtime scope, via jjwt-jackson), confirmed by inspecting the
			 actual dependency:tree output, not assumed. Declaring it
			 directly here is simpler than adopting Spring's new Jackson
			 abstraction for one converter class. No version pinned: Spring
			 Boot's own BOM manages it (resolves to the same 2.21.4
			 jjwt-jackson already pulls in). -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<dependency>
			<groupId>com.oracle.database.jdbc</groupId>
			<artifactId>ojdbc11</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- JWT: mirrors python-jose's role in security.py (simple, direct
			 encode/decode, not a full OAuth2 authorization server). -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

		<!-- HtmlDiffer (article revision diffing): mirrors diffing.py's role.
			 jsoup replaces BeautifulSoup for block-element extraction;
			 java-diff-utils (Myers algorithm) replaces difflib.SequenceMatcher
			 (Ratcliff-Obershelp) for the actual diff, a different algorithm,
			 not a port of Python's, since the migration doc's own acceptance
			 criterion for this endpoint only requires identical ins/del
			 semantics, not identical markup. -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
			<version>1.18.1</version>
		</dependency>
		<dependency>
			<groupId>io.github.java-diff-utils</groupId>
			<artifactId>java-diff-utils</artifactId>
			<version>4.12</version>
		</dependency>

		<!-- Exports domain: openpyxl/reportlab equivalents. Apache POI is the
			 de facto Java standard for XLSX (Apache-2.0, no serious
			 alternative worth weighing). PDFBox chosen over OpenPDF/iText for
			 PDF generation: also Apache-2.0 (OpenPDF is LGPL/MPL, iText 7 is
			 AGPL and a poor fit for a proprietary network-served app);
			 user-confirmed choice, 2026-08-06. PDFBox has no built-in
			 high-level "Table" component like reportlab's Platypus, so
			 PdfExportBuilder lays out rows/pagination by hand. -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.3.0</version>
		</dependency>
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.3</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Applies the schema without starting the application: `mvn
				 flyway:migrate -Dflyway.url=... -Dflyway.user=... -Dflyway.password=...`.
				 The app itself still runs Flyway on startup exactly as before; this
				 plugin adds a way to migrate a database that has no app in front of
				 it yet, which is what a DBA doing a cutover has, and what the
				 Postgres to Oracle ETL rehearsal needs before it can load anything
				 (see docs/DATA_MIGRATION_PG_TO_ORACLE_KA.md).

				 Both dependencies are explicit because the plugin resolves its own
				 classpath, not the project's: Flyway 10+ ships each database in a
				 separate module, so without flyway-database-oracle it reports "no
				 database module" against an Oracle URL, and without the JDBC driver
				 it cannot connect at all. Versions come from the Spring Boot parent
				 so they cannot drift from the ones the application runs with. -->
			<plugin>
				<groupId>org.flywaydb</groupId>
				<artifactId>flyway-maven-plugin</artifactId>
				<version>${flyway.version}</version>
				<dependencies>
					<dependency>
						<groupId>org.flywaydb</groupId>
						<artifactId>flyway-database-oracle</artifactId>
						<version>${flyway.version}</version>
					</dependency>
					<dependency>
						<groupId>com.oracle.database.jdbc</groupId>
						<artifactId>ojdbc11</artifactId>
						<version>${oracle-database.version}</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>

</project>
